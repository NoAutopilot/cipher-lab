+class RecKNN:
+    """A small frozen kNN over feats() of labelled exemplar bitmaps (TXE4-10 RECOG-CUT, 12 Oct 2026). Posterior per
+    code = Laplace-smoothed vote share of the k nearest exemplars: p(c) = (votes_c + alpha) / (k + alpha x C), C the
+    number of codes. Used by `segment --split-by-recognition` to score candidate pieces of a joined box, and by the
+    TXE4-10 scripts as the one classifier of every arm (benchmark-tx/txeng4/10/). `exclude` is a set of exemplar
+    indices that may not vote (leave-one-out: an exemplar classified with its own row hidden)."""
+
+    def __init__(self, bm, rows, labels, k=5, alpha=0.5, pca_scale=None):
+        # 'unit' scaling of a PCA fitted on few exemplars blows the numerically-zero trailing components up (feats()'s
+        # own note), and a query's projection then lands far from its own exemplar row: below 120 exemplars 'shared'
+        if pca_scale is None:
+            pca_scale = 'unit' if len(bm) >= 120 else 'shared'
+        self.pca_scale = pca_scale
+        self.X, self.proj = feats(bm, rows, pca_scale=pca_scale, project=True)
+        self.y = np.array(list(labels))
+        self.codes = sorted(set(self.y))
+        self.k, self.alpha = k, alpha
+        self.sids = [r.get('sid', str(i)) for i, r in enumerate(rows)]
+
+    @classmethod
+    def from_atlas(cls, atlas_dir, labels_tsv, **kw):
+        """Exemplars = the atlas rows (signs.tsv + bitmaps.npz) whose sid has a label in LABELS.tsv (box|sid, code)."""
+        rows = read(atlas_dir, 'signs.tsv')
+        bm = np.load(os.path.join(atlas_dir, 'bitmaps.npz'))['signs']
+        lab = {}
+        for r in csv.DictReader(open(labels_tsv), delimiter='\t'):
+            c = (r.get('code') or r.get('label') or '').strip()
+            if c and c != '_':
+                lab[r.get('box') or r.get('sid')] = c
+        keep = [i for i, r in enumerate(rows) if r['sid'] in lab]
+        if len(keep) < kw.get('k', 5) + 1:
+            raise SystemExit(f'RecKNN: only {len(keep)} labelled exemplars in {labels_tsv}')
+        return cls(bm[keep], [rows[i] for i in keep], [lab[rows[i]['sid']] for i in keep], **kw)
+
+    def posteriors(self, Q, exclude=None):
+        """Q: feature rows (from self.proj). Returns a list of {code: p} over the k nearest exemplars."""
+        D = np.linalg.norm(Q[:, None, :] - self.X[None, :, :], axis=2)
+        out = []
+        C = len(self.codes)
+        for i in range(len(Q)):
+            d = D[i].copy()
+            if exclude is not None and exclude[i] is not None:
+                d[list(exclude[i])] = np.inf
+            nn = np.argsort(d)[:self.k]
+            votes = collections.Counter(self.y[j] for j in nn if np.isfinite(d[j]))
+            den = sum(votes.values()) + self.alpha * C
+            out.append({c: (votes.get(c, 0) + self.alpha) / den for c in self.codes})
+        return out
+
+    def topk(self, bms, rh, rw, k=3, exclude=None):
+        """[(code, p) x k, best first] per query bitmap."""
+        if not len(bms):
+            return []
+        P = self.posteriors(self.proj(np.asarray(bms), rh, rw), exclude)
+        return [sorted(p.items(), key=lambda t: (-t[1], t[0]))[:k] for p in P]
+
+    def gain(self, bms, rh, rw):
+        """log p(top) - log(1/C) per query: the top code's log-posterior above uniform (>= 0)."""
+        C = len(self.codes)
+        return [np.log(t[0][1]) + np.log(C) for t in self.topk(bms, rh, rw, k=1)]
+
+
+def _rec_candidates(col, w, mh, grid=0.25, min_piece=0.35):
+    """Candidate cut columns of a wide box: local minima of the column-ink profile plus a grid every grid x mh, each at
+    least min_piece x mh from the edges and from each other (nearer candidates are merged to the one with less ink)."""
+    lo, hi = int(round(min_piece * mh)), w - int(round(min_piece * mh))
+    if hi <= lo:
+        return []
+    cand = set()
+    for x in range(max(1, lo), min(w - 1, hi)):
+        if col[x] <= col[x - 1] and col[x] <= col[x + 1] and (col[x] < col[x - 1] or col[x] < col[x + 1]):
+            cand.add(x)
+    step = max(1, int(round(grid * mh)))
+    for x in range(lo, hi + 1, step):
+        cand.add(x)
+    cand = sorted(cand)
+    out = []
+    for x in cand:
+        if out and x - out[-1] < lo:
+            if col[x] < col[out[-1]]:
+                out[-1] = x
+            continue
+        out.append(x)
+    return out
+
+
+def _rec_split(sub, mh, knn, lam, max_pieces=4, grid=0.25, min_piece=0.35, log=None):
+    """TXE4-10: choose the cut set (0..max_pieces-1 cuts over _rec_candidates) that maximises sum_i gain_i - lam x n,
+    gain_i the RecKNN gain of piece i. Returns the list of (u, v) column intervals of the kept pieces (empty-ink
+    intervals dropped). Degenerate optima, named in PREREG-txeng4-10.md: lam 0 -> max_pieces pieces; lam > max gain ->
+    one piece."""
+    import itertools
+    h, w = sub.shape
+    col = sub.sum(axis=0).astype(float)
+    cand = _rec_candidates(col, w, mh, grid, min_piece)
+    cache = {}
+
+    def piece(u, v):
+        rows = np.where(sub[:, u:v].any(axis=1))[0]
+        if not len(rows):
+            return None
+        return sub[rows[0]:rows[-1] + 1, u:v], (rows[-1] - rows[0] + 1) / mh, (v - u) / mh
+
+    def score(u, v):
+        if (u, v) not in cache:
+            pc = piece(u, v)
+            cache[(u, v)] = None if pc is None else knn.gain([bitmap(pc[0])], [pc[1]], [pc[2]])[0]
+        return cache[(u, v)]
+    best, best_cuts = None, []
+    for ncut in range(0, max_pieces):
+        for cuts in itertools.combinations(cand, ncut):
+            ivs = list(zip((0,) + cuts, cuts + (w,)))
+            sc = [score(u, v) for u, v in ivs]
+            sc = [x for x in sc if x is not None]
+            if not sc:
+                continue
+            tot = sum(sc) - lam * len(sc)
+            if best is None or tot > best + 1e-9:
+                best, best_cuts = tot, list(cuts)
+    ivs = [(u, v) for u, v in zip([0] + best_cuts, best_cuts + [w]) if score(u, v) is not None]
+    if log is not None:
+        log.append(dict(w=w, cand=len(cand), cuts=best_cuts, score=best, pieces=len(ivs)))
+    return ivs
+
+
