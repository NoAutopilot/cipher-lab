+def perm_null(truth, out_lines, a, missing, n, seed):
+    """--perm-null: the output's signs permuted across all its positions, scored n times (0.75-indel err_true)."""
+    import random
+    rnd = random.Random(seed)
+    lines = sorted(out_lines)
+    flat = [s for l in lines for s in out_lines[l]]
+    vals = []
+    for _ in range(n):
+        rnd.shuffle(flat)
+        i, ol = 0, {}
+        for l in lines:
+            ol[l] = flat[i:i + len(out_lines[l])]; i += len(out_lines[l])
+        vals.append(_measure(score_item(truth, ol, missing, G=0.75))[2])
+    vals.sort()
+    lo, hi = vals[int(0.025 * (n - 1))], vals[int(0.975 * (n - 1))]
+    return dict(n=n, seed=seed, mean=round(sum(vals) / n, 4), p2_5=round(lo, 4), p97_5=round(hi, 4))
+
+
+def seg_boxes(truth, boxes_path, topk_path):
+    """--seg-boxes: boxes vs truth positions per line, and a label-aware map of the boxes to the truth sequence."""
+    import tempfile
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    import box_token_align as BTA, join_check as JC
+    boxes = read_tsv(boxes_path)
+    by_line = defaultdict(list)
+    for r in truth:
+        by_line[r['line']].append(r)
+    lines = sorted(l for l in by_line if any(b['line'] == l for b in boxes))
+    signs, read = [], []
+    for l in lines:
+        page, li = BTA.split_line(l)
+        for b in boxes:
+            if b['line'] == l:
+                signs.append(dict(sid=b['sid'], page=page, line=li, x=b.get('x_line') or b['x'], w=b['w']))
+        for r in sorted(by_line[l], key=lambda r: float(r['pos'])):
+            read.append(dict(line=l, pos=str(int(float(r['pos']))), sign=r['ref_sign']))
+    labels = BTA.read_labels(topk_path) if topk_path else None
+    rows, per = BTA.build_map(signs, read, labels, None, lines, BTA.LAM, BTA.NEUTRAL, True)
+    ops = Counter(r['op'] for r in rows)
+    nbox = sum(per[l]['boxes'] for l in lines)
+    one = sum(1 for r in rows if r['op'] == '1:1')
+    d = dict(lines=len(lines), boxes=nbox, truth_positions=sum(per[l]['tokens'] for l in lines),
+             abs_diff=sum(abs(per[l]['boxes'] - per[l]['tokens']) for l in lines),
+             share_1to1=round(one / nbox, 4) if nbox else None, ops=dict(ops),
+             boxes_2to1=sum(1 for r in rows if r['op'] == '2:1'), tokens_1to2=sum(1 for r in rows if r['op'] == '1:2'),
+             skipped_boxes=sum(len(per[l]['skipped']) for l in lines), skipped_tokens=ops.get('skiptok', 0),
+             unsure=ops.get('unsure', 0))
+    if topk_path:
+        chk = {r.get('box') or r.get('sid'): r.get('k1') for r in read_tsv(topk_path) if (r.get('k1') or '_') != '_'}
+        rs = defaultdict(set)
+        for r in read:
+            rs[(r['line'], int(r['pos']))].add(r['sign'])
+        res = JC.evaluate(BTA.positions(rows, loo=True), chk, rs)
+        d['shift_check_loo'] = {k: res[k] for k in ('verdict', 'share0', 'p95_0', 'sharepm1', 'b2_bound') if k in res}
+        d['shift_check_loo']['counts'] = res.get('overall') or res.get('counts')
+    return d
+
+
