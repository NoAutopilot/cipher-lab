+def load_canonical_boxes(path, d):
+    """--canonical-boxes: {token: the drawn cell cut from DIR/<drawing> by the row's x0, y0, x1, y1} (TXE4-1)."""
+    out, ims = {}, {}
+    for r in csv.DictReader(open(path), delimiter='\t'):
+        fn = r['drawing']
+        if fn not in ims:
+            ims[fn] = cv2.imread(os.path.join(d, fn), cv2.IMREAD_GRAYSCALE)
+            if ims[fn] is None:
+                sys.exit(f'--canonical-boxes: cannot read {os.path.join(d, fn)}')
+        x0, y0, x1, y1 = (int(r[k]) for k in ('x0', 'y0', 'x1', 'y1'))
+        out[r['token']] = ims[fn][y0:y1, x0:x1]
+    return out
+
+
+def derange(codes, seed):
+    """{code: other code} over the codes given: a seeded derangement (no code maps to itself; needs >= 2 codes)."""
+    import random
+    if len(codes) < 2:
+        return {c: c for c in codes}
+    rnd = random.Random(seed)
+    order = list(codes)
+    while True:
+        rnd.shuffle(order)
+        if all(a != b for a, b in zip(codes, order)):
+            return dict(zip(codes, order))
+
