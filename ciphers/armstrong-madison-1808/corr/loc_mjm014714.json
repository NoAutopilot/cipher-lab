"description": [""], "digitized": true, "extract_timestamp": "2025-11-18T20:22:07.123Z", "group": ["mjm", "james-madison-papers"], "hassegments": true, "id": "http://www.loc.gov/item/mjm013857/", "image_url": ["https://tile.loc.gov/storage-services/master/mss/mjm/07/0700/0709d.jpg", "https://tile.loc.gov/storage-services/master/mss/mjm/07/0700/0709d.jpg#h=2769&w=1772"], "index": 5, "language": ["english"], "mime_type": ["image/jpeg"], "number": ["mjm013857"], "online_format": ["image"], "original_format": ["manuscript/mixed material"], "partof": ["manuscript division", "james madison papers, 1723-1859", "james madison papers, 1723-1859:  series 1, general correspondence, 1723-1859", "american memory"], "score": 20.329609, "shelf_id": "Series: Series 1, General Correspondence, 1723-1859 Microfilm Reel: 7", "subject": ["manuscripts", "general correspondence"], "timestamp": "2025-11-18T20:36:28.921Z", "title": "George W. Erving. Statistics & Remarks, British Claims. 1802.", "type": ["manuscript"], "url": "https://www.loc.gov/item/mjm013857/"}, {"access_restricted": false, "aka": ["http://www.loc.gov/collections/james-madison-papers/about-this-collection/", "http://www.loc.gov/collections/madison/", "http://www.loc.gov/collections/mjm/", "https://lccn.loc.gov/mm81031021", "https://www.loc.gov/item/mm81031021", "http://lccn.loc.gov/mm81031021", "http://www.loc.gov/item/mm81031021/", "https://search.catalog.loc.gov/instances/9be8f688-7859-5f7b-8aa9-a72ccec89a87", "https://hdl.loc.gov/loc.mss/collmss.ms000003"], "campaigns": [], "contributor": ["madison, james"], "count": 12011, "date": "1723", "dates": ["[1723 TO 1836]"], "description": ["James Madison (1751-1836) is one of 23 presidents whose papers are held in the Manuscript Division of the Library of Congress. The Madison Papers consist of approximately 12,000 items, spanning the period 1723-1859, captured in some 37,714 digital images. They document the life of the man who came to be known as the &ldquo;Father of the Constitution&rdquo; through correspondence, personal notes, drafts of letters and legislation, an autobiography, legal and financial documents, and his notes on the 1787 federal Constitutional Convention. The papers cover Madison&rsquo;s years as a college student; as a member of the Virginia House of Delegates, Continental Congress, and Confederation Congress; as a delegate to the 1787 federal Constitutional Convention and the Virginia ratification convention of 1788; his terms in the House of Representatives, as secretary of state, and as president of the United States. Also documented are his retirement and the settlement of his estate; matters relating to his family, including his wife, Dolley Payne Madison; and his home, Montpelier, in Virginia. For information about the ownership and chain of custody of the Library&rsquo;s Madison Papers, see the Provenance essay on this site, which is excerpted from the Index to the James Madison Papers (Washington, D.C.: Library of Congress, 1965). The Manuscript Division has a separate collection of Dolley Madison Papers, 1794-1852, for which there is an online finding aid."], "digitized": true, "extract_timestamp": "2026-09-27T05:11:07.936Z", "group": ["collections-portal"], "hassegments": false, "id": "http://www.loc.gov/collections/james-madison-papers/about-this-collection/", "image_url": ["https://www.loc.gov/static/collections/james-madison-papers/500_500.jpg"], "index": 6, "items": "https://www.loc.gov/collections/james-madison-papers/", "language": ["english"], "location": ["united states", "virginia"], "number": ["mm81031021", "2025-06-07t22:49:43.700000"], "original_format": ["collection", "manuscript/mixed material"], "partof": ["james madison papers, 1723-1859", "digital collections", "manuscript division"], "score": 18.209412, "shelf_id": "~/collections/james-madison-papers/about-this-collection/", "subject": ["personal correspondence", "manuscripts", "war of 1812", "american history", "american revolution", "c