TARGET [d-hook] n 10 hypothesis/key e: score(e) 6 rank 1 | top5 e:6 a:3 s:3 n:2 g:1 | e 6 | decision ACCEPT e (= key)
   2046_leg_d:24 e <- 3 words, e.g. beset, besetting, setting
   2046_leg_d:57 e <- 2 words, e.g. neeger, neegers
   2046_leg_efgh:30 e <- 2 words, e.g. battery, batteryen
   2046_leg_efgh:58 e <- 3 words, e.g. dinge, dingen, ingen
   2046_leg_ki:5 e <- 5 words, e.g. corle, corre, reede, rhede, roede
   2046_leg_ki:24 e <- 2 words, e.g. eerde, eerden
gate: primary h ACCEPT n; controls accepting key value 1/5 (h) -> FAIL (non-test)
verdict: undecided (gate FAIL, non-test)
