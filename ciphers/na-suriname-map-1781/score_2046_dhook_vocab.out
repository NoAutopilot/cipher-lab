   2046_head2:19 v <- 1 words, e.g. veren
   2046_leg_d:9 v <- 1 words, e.g. voorde
CONTROL [hash] n 9 hypothesis/key o: score(o) 3 rank 1 | top5 o:3 a:2 e:2 w:2 b:1 | e 2 | decision UNDECIDED
   2046_leg_d:10 o <- 1 words, e.g. voorde
