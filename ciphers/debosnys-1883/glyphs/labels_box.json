 "desc": {
  "MISC-00": "small mixed junk (arrow/slash/dot/dbl-dash), n=4, not one shape",
  "BAR-SERIF": "tall thin vertical stroke with small foot/serif",
  "HOOK-L": "small left-opening hook/curl (comma-like)",
  "MISC-03": "mixed small squiggles (numeral-like), n=5, not one shape",
  "X": "plain X cross (St Andrew's cross)",
  "MISC-05": "heterogeneous bucket (pct/square/triangle/circle-x/arrow), n=32 -- needs by-eye split, not one sign",
  "MISC-06": "mixed loopy shapes (ampersand/Venus/tally/z-curl), n=11 -- not one shape",
  "MISC-07": "mixed complex glyphs (house-like/varied), n=11 -- not one shape",
  "BAR-SOLID": "fully-inked solid vertical bar/wedge",
  "PCT": "double-loop percent-like sign",
  "MISC-11": "mixed pictogram-like (sunburst-small/circle-P/figure), n=8 -- not one shape",
  "BAR-THIN": "thin vertical stroke, some slightly curved like ( or l",
  "MISC-13": "mixed complex (figure-8/pct/key-like), n=21 -- not one shape",
  "DASH-V": "short vertical dash/tick (possibly punctuation)",
  "SUN": "sunburst pictogram (majority of cluster); a few rare pictograms (anchor/runner/wheel) also fell in here, not split out -- see exemplars",
  "MISC-17": "mixed diagonal strokes/arrows, n=16 -- not one shape",
  "GEAR-DOT": "small round sign with internal dot/spokes",
  "Y-CURL": "Y/chi-like forked stroke with curl",
  "MISC-20": "mixed hook/circle shapes, n=10 -- not one shape",
  "MISC-21": "mixed complex glyphs (E-bar/omega/P/tally), n=13 -- not one shape",
  "LOOP-TAIL": "small loop with descending tail (a/d-like)",
  "MISC-24": "mixed pictogram-ish squiggles, n=13 -- not one shape",
  "WAVE": "horizontal wave/S-curve stroke",
  "MISC-29": "mixed pictogram squiggles (spider-like/circle-pct/infinity), n=18 -- not one shape",
  "MISC-30": "mixed (staff/flag/A/tally), n=13 -- not one shape",
  "MISC-31": "mixed swirl/hook variants (\"ox\" pairs, spiral), n=22 -- not one shape",
  "MISC-32": "mixed solid blocks (square/triangle/arrow), n=11 -- not one shape",
  "MISC-33": "mixed hook/circle-tailed shapes, n=18 -- not one shape",
  "PHI": "phi-like: loop crossed by a vertical stroke",
  "MISC-35": "mixed thin marks (line/small figure/X), n=6 -- not one shape",
  "MISC-36": "mixed complex squiggles, n=14 -- not one shape",
  "MISC-37": "mixed complex squiggles (bird-like/hook), n=12 -- not one shape",
  "CIRC-TAIL": "circle or loop with a small tail/hook",
  "TRIDENT": "trident/psi-like fork (V with extra prong)",
  "MISC-40": "mixed small glyphs (bird-track/staff/circle-crossbar), n=9 -- not one shape",
  "MISC-41": "mixed ornate scissor-like shapes, n=14 -- not one shape",
  "CIRC-O": "plain circle/donut (letter O / zero-like)",
  "MISC-43": "mixed ornate (V-loop/box/staff/hook), n=12 -- not one shape",
  "CRESCENT": "crescent/C-shape, moon-like",
  "MISC-46": "mixed pct-ish plus rare letters (A, T), n=14 -- not one shape",
  "CROSS-T": "Latin cross / dagger (cross with horizontal bar near top)",
  "VENUS": "loop over a small cross/tail (Venus-symbol-like)",
  "MISC-50": "small mixed marks (short vertical + dot), n=5 -- possibly attribute marks misclassified as signs",
  "MISC-54": "mixed ornate loop-with-descender (bird-head-like), n=10 -- not one shape",
  "MISC-55": "mixed solid filled rounded/blocky shapes, n=18 -- several distinct solid pictograms, not one shape",
  "VEE": "V or checkmark stroke",
  "MISC-60": "rare pictograms (animal/bird silhouettes), n=6 -- likely several distinct pictograms, not one sign",
  "DASH-H": "short horizontal dash/bar",
  "NOTE": "loop with descending tail (musical-note/letter-b-like)",
